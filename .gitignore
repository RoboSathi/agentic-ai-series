__pycache__/
*.pyc
.venv/
venv/
.env
.coverage
.deepeval/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
.idea
logs/*
src/agent_platform/config/local.yaml

# Claude specific
.claude
CLAUDE.md
last_claude_session.txt

# Zip file
project.zip

# Runtime state lives outside src/, one folder per package (agent_platform or an agent):
#   db/<package>/    every database: built from its seed (`make dummy-data csa`), by the
#                    knowledge ingest at start-up, by the eval fixture builder, or at run time.
#   data/<package>/  every other runtime file: memory, analytics Parquet, eval workspaces.
# Neither is versioned.
db/*
data/*

# Reports: one per eval framework per run (`make eval <agent>`), rebuilt from the eval store.
# The folders are kept, their contents are not.
reports/*
reports/**
!reports/**/
!reports/**/.gitkeep'


# Any database that lands anywhere else is still runtime state.
*.db
*.db-wal
*.db-shm
*.db-journal
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Rill: the repo-local binary (`make dashboard-install`), the source link `make dashboard`
# makes, Rill's own runtime state, and the project generated from the semantic layer
# (analytics/dashboards.py). Only rill.yaml is versioned.
src/agent_platform/analytics/dashboards/.rill/
src/agent_platform/analytics/dashboards/rill/data
src/agent_platform/analytics/dashboards/rill/tmp/
src/agent_platform/analytics/dashboards/rill/.env
src/agent_platform/analytics/dashboards/rill/models/
src/agent_platform/analytics/dashboards/rill/metrics/
src/agent_platform/analytics/dashboards/rill/dashboards/

# Models downloaded from Hugging Face (NLI, summariser, spaCy) and HF caches.
local_models/
**/local_models/
.cache/huggingface/

# Patches
*.patch
patches/*
