# LLM Providers
nvidia_api_key=your-nvidia-nim-api-key
hf_api_key=your-huggingface-api-key

# Logging
LOGGING__LEVEL=INFO
LOGGING__COLORIZE=true
LOGGING__CONSOLE_ENABLED=true
LOGGING__FILE_ENABLED=true
LOGGING__LOG_DIR=logs

# Config toggles (SECTION__FIELD format)
CONFIG__ENABLED=true

LLM__ENABLED=true

PERSISTENCE__ENABLED=true

OBSERVABILITY__ENABLED=true

AUDIT__ENABLED=true

EVALS__ENABLED=true

GUARDRAILS__ENABLED=true

RESILIENCE__ENABLED=true

SECURITY__ENABLED=true
SECURITY__AUTH__ENABLED=true
SECURITY__PII__ENABLED=true
SECURITY__PROMPT_INJECTION__ENABLED=true
SECURITY__CONTENT_MODERATION__ENABLED=true

MEMORY__ENABLED=true

TOOLS__ENABLED=true

GATEKEEPER__ENABLED=true

HALLUCINATION_PROTECTION__ENABLED=true

CUSTOMER_SUPPORT_AGENT__ENABLED=true
