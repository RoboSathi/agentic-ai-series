# Which agent runs on the platform. `agent_platform` never names one:
# its own config ships `overlays: []`, and this is where the agent layer
# is declared. The Makefile exports this for every target, so you only
# need it here if you run a module directly.
AGENTIC_OVERLAYS=src/customer_support_agent/config/config.yaml

# LLM Providers
nvidia_api_key=your-nvidia-nim-api-key
hf_api_key=your-huggingface-api-key

# Encrypts checkpoints at rest (durability.encryption). 16, 24 or 32 bytes.
# Without it checkpoints are stored in plaintext and a warning is logged,
# unless durability.encryption.required is true, in which case start-up fails.
LANGGRAPH_AES_KEY=change-me-to-32-bytes-of-randomness

# Keys the PII vault and its redaction tokens (security.pii.vault). `make gen-key >> .env`
# writes both keys fresh.
PII_VAULT_KEY=change-me-to-32-bytes-of-randomness

# Logging verbosity (unaffected by config.yaml)
LOGGING__LEVEL=INFO
LOGGING__COLORIZE=true
LOGGING__CONSOLE_ENABLED=true
LOGGING__FILE_ENABLED=true
LOGGING__LOG_DIR=logs

# Every subsystem's enabled toggle — and the LLM's provider/base_url/model/
# timeout/max_tokens — now live in src/agent_platform/config/config.yaml,
# not here. Copy config/local.yaml.example to config/local.yaml (gitignored)
# to override any of it on your machine without touching the tracked file.
#
# The default nim model is a reasonable placeholder — NIM entitlements are
# per-account, so confirm your key can actually invoke it before relying on
# `generate()`. `make llm-check` validates connectivity/auth via
# models.list(), independent of model entitlement.
